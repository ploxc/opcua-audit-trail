[Unit]
Description=OPC UA Audit Gateway
Documentation=https://github.com/Harted/opcua-audit-trail
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opcua-gw
Group=opcua-gw
ExecStart=/usr/local/bin/opcua-audit-gateway --config /etc/opcua-audit-gateway/config.toml run
Restart=on-failure
RestartSec=5
# Logs go to the journal: journalctl -u opcua-audit-gateway

# Hardening. The gateway writes only its data directory and its config file
# (targets changed in the web UI are saved there).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/opcua-audit-gateway /etc/opcua-audit-gateway
# Allow ports below 1024 (e.g. 443 for the web UI) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
